# TimeOff Management System - Environment Configuration
# For PHP 8.2 / XAMPP 8.2 / Ubuntu

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/New_York
HEADER_TITLE="TimeOff Management"
BRANDING_URL=http://localhost/timeoff

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=timeoff_db
DB_USER=root
DB_PASSWORD=

# For production, use strong password:
# DB_PASSWORD=STRONG_PASSWORD_HERE

# ============================================================================
# SECURITY SETTINGS (CRITICAL - CHANGE IN PRODUCTION)
# ============================================================================
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_STRING_MIN_32_CHARS

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
SEND_EMAIL=false

# SMTP Settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_AUTH_REQUIRED=true
SMTP_AUTH_USER=your-email@gmail.com
SMTP_AUTH_PASS=your-app-password
SMTP_FROM=noreply@yourcompany.com

# For other providers:
# Office 365: smtp.office365.com:587
# SendGrid: smtp.sendgrid.net:587
# Mailgun: smtp.mailgun.org:587

# ============================================================================
# REGISTRATION SETTINGS
# ============================================================================
# Allow new company registrations
OPTION_ALLOW_NEW_REGISTRATIONS=false

# ============================================================================
# GOOGLE OAUTH (OPTIONAL)
# ============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_DOMAINS=yourcompany.com,example.com

# Get credentials from: https://console.developers.google.com/

# ============================================================================
# CLOUDFLARE TURNSTILE (OPTIONAL CAPTCHA)
# ============================================================================
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Get from: https://dash.cloudflare.com/

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=error
# Options: debug, info, notice, warning, error, critical, alert, emergency

# ============================================================================
# PERFORMANCE
# ============================================================================
CACHE_ENABLED=true
CACHE_DRIVER=file
# Options: file, database, redis

# ============================================================================
# LOCALE
# ============================================================================
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=America/New_York

# Available timezones: https://www.php.net/manual/en/timezones.php
