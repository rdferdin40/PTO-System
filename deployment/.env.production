## TimeOff.Management Production Environment Configuration
## For Ubuntu Server Deployment in /var/www/html

### IMPORTANT: Before deploying to production:
### 1. Copy this file to /var/www/html/PTO-System/.env
### 2. Update ALL placeholder values with your actual credentials
### 3. Set proper file permissions: sudo chmod 600 /var/www/html/PTO-System/.env
### 4. Ensure only www-data user can read: sudo chown www-data:www-data /var/www/html/PTO-System/.env

### Application Settings
BRANDING_URL=https://your-domain.com    # CHANGE: Your actual domain name
APP_PORT=3000                            # Port for Node.js (Apache will proxy from 80/443)
HEADER_TITLE="TimeOff Management"        # Customize your application title
# BRANDING_WEBSITE=https://your-company.com
# CONTACT_EMAIL_ADDRESS=hr@your-domain.com

### Public Banner Configuration
SHOW_PUBLIC_BANNER=false                 # Set to true if you want to show a banner
PUBLIC_BANNER_MESSAGE="Maintenance scheduled for Saturday 2am-4am"
PUBLIC_MESSAGE_BG="#000000"              # Banner background color
PUBLIC_MESSAGE_FONT="#ffffff"            # Banner font color

### Database Configuration - PostgreSQL (REQUIRED FOR PRODUCTION)
## IMPORTANT: Replace with your actual database credentials
## Option 1: Local PostgreSQL on Ubuntu
DATABASE_URL="postgresql://timeoff_user:CHANGE_THIS_PASSWORD@localhost:5432/timeoff_db"

## Option 2: Remote PostgreSQL (Hosted)
# DATABASE_URL="postgresql://username:password@your-db-host.com:5432/timeoff_db?sslmode=require"

## Individual Database Settings (must match DATABASE_URL)
DB_DATABASE=timeoff_db
DB_USER=timeoff_user
DB_PASSWORD=CHANGE_THIS_PASSWORD         # CHANGE: Use a strong password
DB_HOST=localhost                         # Or your remote database host
DB_PORT=5432
DB_DIALECT=postgres

### SSL Configuration for Database
## For hosted databases (AWS RDS, Azure, etc.), enable SSL
USE_SSL=false                             # Set to true for remote databases
DB_SSL_REQUIRE=false                      # Set to true for hosted databases requiring SSL
DB_SSL_REJECT_UNAUTHORIZED=true           # Set to true in production with valid SSL certs

### Security Settings (CRITICAL)
## IMPORTANT: Generate a strong random session secret
## Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_STRING_MIN_32_CHARS

## Registration Settings
OPTION_ALLOW_NEW_REGISTRATIONS=false      # DISABLE in production after initial setup

## API Access (Optional)
# API_KEY=CHANGE_THIS_TO_A_STRONG_API_KEY # Generate with: openssl rand -base64 32

### Email Configuration (REQUIRED FOR PRODUCTION)
SEND_EMAIL=true                           # Enable email notifications

### Option 1: SMTP Configuration (Gmail, Office365, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com                  # CHANGE: Your SMTP server
SMTP_PORT=587                             # 587 for TLS, 465 for SSL
SMTP_AUTH_REQUIRED=true
SMTP_AUTH_USER=your-email@gmail.com       # CHANGE: Your SMTP username
SMTP_AUTH_PASS=your-app-password          # CHANGE: Your SMTP password or app password
SMTP_REQUIRE_TLS=true
SMTP_FROM="TimeOff System <noreply@your-domain.com>"  # CHANGE: Your from email

### Option 2: Resend API (Alternative to SMTP)
# RESEND_API_KEY="re_xxxxxxxxxxxxx"       # If not provided, falls back to SMTP

### Cloudflare Turnstile (Bot Protection - Optional)
# TURNSTILE_SITE_KEY="your-site-key"
# TURNSTILE_SECRET_KEY="your-secret-key"

### Logging Configuration
NODE_ENV=production                       # Always use 'production' in production

### Performance Tuning (Optional)
# NODE_OPTIONS="--max-old-space-size=2048"  # Increase if you have memory issues

### Timezone Configuration (Optional)
# TZ=America/New_York                      # Set your server timezone
